# The rule this file follows: everything the pipeline NEEDS to run is tracked;
# everything it PRODUCES is not. Patterns are root-anchored (leading /) wherever
# a bare name would also match inside the package — /data/ must not hide
# patentdb/data/, which is how the vocabulary went untracked before.

# ── Python / build artifacts ─────────────────────────────────────
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
dist/
build/
/tmp/

# ── Environments + secrets ───────────────────────────────────────
venv/
venv_mineru/
.env

# ── Retired code, kept on disk only. See _attic/MANIFEST.md ──────
/_attic/

# ── Source corpus + reference dumps (large; fetched per run) ─────
/data/patents/
/data/*.tsv
/data/*.zip
*.pdf

# ── Generated output ─────────────────────────────────────────────
# output_v2/ holds the LLM and Google-Patents response caches. Regenerable,
# but only by paying for the API calls again — never delete it casually.
/output/
/output_v2/
/mineru_output/

# ── Local agent + tooling state ──────────────────────────────────
.claude/
graphify-out/

# ── Learned data under patentdb/data/ ────────────────────────────
# The canonical vocabulary and the built target index ARE tracked: the
# pipeline cannot run without them, and rebuilding the index needs the
# 8 GB BindingDB dump this repo deliberately does not carry. Runtime
# accumulation and network caches are not.
# The learned layout-rule library is runtime accumulation (and currently holds
# mostly negative/escalation entries from experiments), same class as the
# discovery files below.
patentdb/data/layout_rules.json
patentdb/data/*.discoveries.json
patentdb/data/ref_ik_cache.json

# ── Markdown: only the three keepers travel with the repo ────────
# Walkthroughs, phase notes and ad-hoc analysis live in docs/notes/
# and stay local by design.
*.md
!CLAUDE.md
!README.md
!ARCH.md

# v3 produced artifacts — the dump, its manifest and the workbook
/patentdb3/out/
/output_v3/

# ── v2 run artifacts. v2 is reference-only and must never be ADDED to; these
# are files a v2 run drops into its own data dir, not inputs anything reads.
/patentdb_v2/data/*.json

# ── Agent/editor scratch, and hand-made screenshots from investigations ──
/.codex/
/.playwright-mcp/
/docs/backups/
/docs/notes/
/data/*.json
*.bak
/*.png

# ── v2, retired. Kept ON DISK for reference (see CLAUDE.md) but never
# published: it is not the live package and must not be added to.
/patentdb_v2/
