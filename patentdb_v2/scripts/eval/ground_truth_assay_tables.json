{
  "_meta": {
    "purpose": "Ground-truth assay-table extractions for evaluating OCR-tool quality.",
    "curation_method": "Hand-curated from PaddleX-OCR'd markdown source, cross-verified against BindingDB values for compounds that appear in both. Each `expected` row represents ONE (compound_id, assay_name, value, unit, qualifier) tuple that should be extracted.",
    "schema": {
      "patent_id": "str",
      "page": "int",
      "table_index": "int (0 = first <table> on page)",
      "table_format": "single_column | two_up | bleed_through (descriptive)",
      "expected": [
        {
          "compound_id": "str (verbatim from compound column)",
          "assay_name": "str (descriptive \u2014 IC50 / EC50 / FRET_IC50 etc., or full column header)",
          "value": "number (verbatim from cell)",
          "unit": "str (\u03bcM / nM / mM)",
          "qualifier": "str | null (< > ~ etc.)"
        }
      ]
    },
    "scoring_rules": {
      "exact_match": "all 5 fields match (case-insensitive on compound_id, qualifier null treated as no-qualifier)",
      "value_only_match": "compound_id + value match (ignores name/unit normalization differences)",
      "compound_id_match": "compound_id exists in extraction"
    },
    "corrections": [
      {
        "date": "2026-05-03",
        "patent": "US11312727",
        "page": 235,
        "compound_id": "43A",
        "fix": "A549_A(H1N1) EC50: 0.006 -> 0.022; FRET_IC50: 0.018 -> 0.024",
        "reason": "Hand-curation error confirmed via BindingDB cross-check. BDB shows cpd 43A IC50=24nM (=0.024 uM), EC50=22nM (=0.022 uM). Original GT had values that actually belong to cpd 42A (whose IUPAC entry in BDB has IC50=18nM=0.018, EC50=6nM=0.006)."
      }
    ]
  },
